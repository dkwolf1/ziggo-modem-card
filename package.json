{
  "name": "ziggo-modem-card",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/ziggo-modem-card.test.cjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run format:check && npm run check:package && npm test",
    "check:package": "node scripts/check-package.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
